{
  "manifest_version": 3,
  "name": "金沢大学カレンダー同期",
  "version": "1.0.2",
  "description": "金沢大学ポータルとWebClass LMSから履修情報・課題情報を取得し、KU Calendarに同期します。",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "host_permissions": [
    "https://eduweb.sta.kanazawa-u.ac.jp/*",
    "https://lms-wc.el.kanazawa-u.ac.jp/*",
    "https://ku-calendar-app.onrender.com/*",
    "https://lzpofmjgptzfjhkiqbqp.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://eduweb.sta.kanazawa-u.ac.jp/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://eduweb.sta.kanazawa-u.ac.jp/Portal/StudentApp/Regist/RegistList.aspx*",
        "https://eduweb.sta.kanazawa-u.ac.jp/Portal/StudentApp/Top.aspx*",
        "https://eduweb.sta.kanazawa-u.ac.jp/Portal/StudentApp/Blank.aspx*",
        "https://lms-wc.el.kanazawa-u.ac.jp/webclass/course.php/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://ku-calendar-app.onrender.com/*"],
      "js": ["appContent.js"]
    }
  ]
}
