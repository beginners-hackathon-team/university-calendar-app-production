# Frontend environment variables
# .env.development / .env.production にコピーして使用
# .env.local は個人PC用の上書きのみ

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 開発時のみ必要（dev server 起動時のプロキシ先）
VITE_API_PROXY_TARGET=http://localhost:8000

# Chrome拡張機能の Chrome Web Store URL（未設定の場合はボタン非表示）
VITE_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/%E9%87%91%E6%B2%A2%E5%A4%A7%E5%AD%A6%E3%82%AB%E3%83%AC%E3%83%B3%E3%83%80%E3%83%BC%E5%90%8C%E6%9C%9F/cgjmbdnfbmcfiophnnanbakhoflnihom?hl=ja
